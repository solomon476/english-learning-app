# Solian Wolves Learning Platform — Environment Variables Template
# Copy to .env.local for local overrides. Never commit API keys.

# Environment
NODE_ENV=development
VITE_APP_TITLE="Solian Wolves Learning"
VITE_APP_VERSION="1.0.0"

# Application Backend / Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# AI Provider Gateway (Handled strictly server-side / simulated safe adapter in demo)
AI_TUTOR_PROVIDER=gemini-3.8-flash # or 'openai', 'anthropic', 'mock-grounded'
AI_TUTOR_API_KEY=
AI_TUTOR_MAX_OUTPUT_TOKENS=1500
AI_TUTOR_RATE_LIMIT_PER_HOUR=20

# Feature Flags
VITE_ENABLE_AI_TUTOR=true
VITE_ENABLE_OFFLINE_DEMO_MODE=true
